<%- include('partials/header.ejs'); %>

<div class="box" id="heading">
    <h1>Edit Book</h1>
</div>

<div class="form">
    <form action="/edit" method="post">
        <p><strong>Title:</strong> <%= book.title %></p>
        <p><strong>Author:</strong> <%= book.author %></p>

        <label for="notes">Notes:</label>
        <textarea id="notes" name="notes"><%= book.notes %></textarea>

        <label for="rating">Rating (0-5):</label>
        <input type="number" id="rating" name="rating" value="<%= book.rating %>" min="0" max="5">

        <label for="date_read">Date Read:</label>
        <input type="date" id="date_read" name="date_read" value="<%= book.date_read ? book.date_read.toISOString().split('T')[0] : '' %>">

        <input type="hidden" name="id" value="<%= book.id %>">

        <button type="submit">Save Changes</button>
    </form>
</div>

<%- include('partials/footer.ejs'); %>