<%- include('partials/header.ejs'); %>

<main>

<div class="box" id="heading">
    <h1><%= listTitle %></h1>
</div>


<!-- Add Book Form -->
<div class="form">

    <form action="/add" method="post">

        <label class="sr-only" for="title">Book title</label>
        <input 
            id="title"
            type="text"
            name="title"
            placeholder="Book Title"
            required
        >

        <label class="sr-only" for="rating">Rating</label>
        <input 
            id="rating"
            type="number"
            name="rating"
            placeholder="Rating (0-5)"
            min="0"
            max="5"
        >

        <label class="sr-only" for="notes">Book notes</label>
        <textarea 
            id="notes"
            name="notes"
            placeholder="Your notes..."
        ></textarea>

        <label class="sr-only" for="date_read">Date read</label>
        <input 
            id="date_read"
            type="date"
            name="date_read"
        >

        <button type="submit">
            Add Book
        </button>

    </form>

</div>



<!-- Book Cards -->

<section class="box">

    <% if(listItems.length === 0) { %>

        <p>No books have been added yet. Add your first book above.</p>

    <% } %>



    <% for(let book of listItems){ %>

        <article class="book_item">


            <div class="book_cover_container">

                <img 
                    src="<%= book.cover_url || '/assets/default-cover.jpg' %>"
                    alt="Cover of <%= book.title %>"
                    class="book_cover"
                >

            </div>



            <!-- Edit/Delete Controls -->

            <div class="book_controls">

                <form action="/delete" method="post">

                    <button 
                        type="submit"
                        name="deleteItemId"
                        value="<%= book.id %>"
                        class="delete_button"
                    >
                        Delete
                    </button>

                </form>


                <a 
                    href="/edit/<%= book.id %>"
                    class="edit_button"
                >
                    Edit
                </a>

            </div>



            <p>
                <strong>Title:</strong> 
                <%= book.title %>
            </p>


            <p>
                <strong>Author:</strong> 
                <%= book.author %>
            </p>


            <p>
                <strong>Date Read:</strong> 
                <%= book.date_read 
                    ? new Date(book.date_read).toLocaleDateString() 
                    : "Not recorded" 
                %>
            </p>


            <p>
                <strong>Notes:</strong> 
                <%= book.notes || "No notes added" %>
            </p>



            <p>
                <strong>Rating:</strong>

                <% for (let i = 0; i < (book.rating || 0); i++) { %>

                    <span class="star">⭐</span>

                <% } %>

            </p>


        </article>


    <% } %>


</section>


</main>


<%- include('partials/footer.ejs'); %>